---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portafolio 3D - Desarrollador Web">
  <main>
    <!-- Hero Section -->
    <section id="hero" class="hero-section">
      <div class="container">
        <div class="hero-content fade-in">
          <h1 class="gradient-text hero-title">Desarrollador Web</h1>
          <p class="hero-subtitle">Creando experiencias digitales inmersivas y memorables</p>
          <div class="hero-cta">
            <a href="#projects" class="btn btn-primary">Ver Proyectos</a>
            <a href="#contact" class="btn btn-secondary">Contacto</a>
          </div>
        </div>
      </div>
    </section>

    <!-- About/Skills Section -->
    <section id="about" class="about-section">
      <div class="container">
        <div class="about-content">
          <div class="about-text fade-in">
            <h2 class="section-title">Sobre Mí</h2>
            <p class="about-description">
              Desarrollador especializado en crear experiencias web interactivas y visualmente impactantes.
              Combino diseño creativo con código limpio para construir soluciones digitales que dejan huella.
            </p>
          </div>

          <div class="skills-grid fade-in">
            <div class="skill-card glass">
              <div class="skill-icon">🎨</div>
              <h3>Frontend</h3>
              <ul class="skill-list">
                <li>HTML5, CSS3, JavaScript</li>
                <li>React, Vue, Astro</li>
                <li>Three.js, GSAP, WebGL</li>
                <li>Responsive Design</li>
              </ul>
            </div>

            <div class="skill-card glass">
              <div class="skill-icon">⚙️</div>
              <h3>Backend</h3>
              <ul class="skill-list">
                <li>Node.js, Express</li>
                <li>Python, Django</li>
                <li>RESTful APIs</li>
                <li>Databases (SQL, NoSQL)</li>
              </ul>
            </div>

            <div class="skill-card glass">
              <div class="skill-icon">🚀</div>
              <h3>DevOps & Tools</h3>
              <ul class="skill-list">
                <li>Git, GitHub Actions</li>
                <li>Docker, CI/CD</li>
                <li>Webpack, Vite</li>
                <li>Testing (Jest, Vitest)</li>
              </ul>
            </div>

            <div class="skill-card glass">
              <div class="skill-icon">💡</div>
              <h3>3D & Animation</h3>
              <ul class="skill-list">
                <li>Three.js, WebGL</li>
                <li>GSAP Animations</li>
                <li>Scroll Animations</li>
                <li>Interactive Experiences</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects-section">
      <div class="container">
        <h2 class="section-title text-center fade-in">Proyectos Destacados</h2>
        <p class="section-subtitle text-center fade-in">
          Una selección de mis trabajos más recientes
        </p>

        <div class="projects-grid">
          <article class="project-card glass fade-in">
            <div class="project-image">
              <div class="project-placeholder">
                <span class="project-number">01</span>
              </div>
            </div>
            <div class="project-content">
              <h3 class="project-title">E-Commerce 3D</h3>
              <p class="project-description">
                Plataforma de comercio electrónico con visualización 3D de productos en tiempo real.
              </p>
              <div class="project-tech">
                <span class="tech-tag">React</span>
                <span class="tech-tag">Three.js</span>
                <span class="tech-tag">Node.js</span>
              </div>
              <div class="project-links">
                <a href="#" class="btn btn-small">Ver Demo</a>
                <a href="#" class="btn btn-small">GitHub</a>
              </div>
            </div>
          </article>

          <article class="project-card glass fade-in">
            <div class="project-image">
              <div class="project-placeholder">
                <span class="project-number">02</span>
              </div>
            </div>
            <div class="project-content">
              <h3 class="project-title">Portfolio Interactivo</h3>
              <p class="project-description">
                Portafolio personal con animaciones avanzadas de scroll y efectos 3D inmersivos.
              </p>
              <div class="project-tech">
                <span class="tech-tag">Astro</span>
                <span class="tech-tag">GSAP</span>
                <span class="tech-tag">WebGL</span>
              </div>
              <div class="project-links">
                <a href="#" class="btn btn-small">Ver Demo</a>
                <a href="#" class="btn btn-small">GitHub</a>
              </div>
            </div>
          </article>

          <article class="project-card glass fade-in">
            <div class="project-image">
              <div class="project-placeholder">
                <span class="project-number">03</span>
              </div>
            </div>
            <div class="project-content">
              <h3 class="project-title">Dashboard Analítico</h3>
              <p class="project-description">
                Dashboard en tiempo real con visualizaciones de datos interactivas y animadas.
              </p>
              <div class="project-tech">
                <span class="tech-tag">Vue</span>
                <span class="tech-tag">D3.js</span>
                <span class="tech-tag">Python</span>
              </div>
              <div class="project-links">
                <a href="#" class="btn btn-small">Ver Demo</a>
                <a href="#" class="btn btn-small">GitHub</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="experience-section">
      <div class="container">
        <h2 class="section-title text-center fade-in">Experiencia</h2>

        <div class="timeline">
          <div class="timeline-item fade-in">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass">
              <span class="timeline-date">2023 - Presente</span>
              <h3>Senior Frontend Developer</h3>
              <p class="timeline-company">Tech Company Inc.</p>
              <p>
                Liderando el desarrollo de interfaces 3D interactivas y experiencias web inmersivas
                utilizando las últimas tecnologías.
              </p>
            </div>
          </div>

          <div class="timeline-item fade-in">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass">
              <span class="timeline-date">2021 - 2023</span>
              <h3>Full Stack Developer</h3>
              <p class="timeline-company">Digital Agency Co.</p>
              <p>
                Desarrollo de aplicaciones web completas, desde el diseño hasta la implementación,
                con enfoque en rendimiento y experiencia de usuario.
              </p>
            </div>
          </div>

          <div class="timeline-item fade-in">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass">
              <span class="timeline-date">2019 - 2021</span>
              <h3>Frontend Developer</h3>
              <p class="timeline-company">Startup Studio</p>
              <p>
                Creación de interfaces de usuario modernas y responsivas para diversos proyectos
                de startups en crecimiento.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
      <div class="container">
        <div class="contact-content">
          <div class="contact-text fade-in">
            <h2 class="section-title gradient-text">¿Trabajamos Juntos?</h2>
            <p class="contact-description">
              Estoy disponible para proyectos freelance y colaboraciones.
              Si tienes una idea o necesitas ayuda con tu proyecto, ¡hablemos!
            </p>

            <div class="contact-info">
              <div class="contact-item">
                <span class="contact-icon">📧</span>
                <a href="mailto:tu@email.com">tu@email.com</a>
              </div>
              <div class="contact-item">
                <span class="contact-icon">💼</span>
                <a href="https://linkedin.com" target="_blank">LinkedIn</a>
              </div>
              <div class="contact-item">
                <span class="contact-icon">🐙</span>
                <a href="https://github.com" target="_blank">GitHub</a>
              </div>
              <div class="contact-item">
                <span class="contact-icon">🐦</span>
                <a href="https://twitter.com" target="_blank">Twitter</a>
              </div>
            </div>
          </div>

          <div class="contact-form-wrapper glass fade-in">
            <form class="contact-form" id="contact-form">
              <div class="form-group">
                <label for="name">Nombre</label>
                <input type="text" id="name" name="name" required />
              </div>

              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required />
              </div>

              <div class="form-group">
                <label for="message">Mensaje</label>
                <textarea id="message" name="message" rows="5" required></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-full">Enviar Mensaje</button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <p>&copy; 2024 Portafolio 3D. Creado con Astro y Three.js</p>
      </div>
    </footer>
  </main>

  <script>
    import { SceneManager } from '../lib/SceneManager.js';
    import { ScrollAnimations } from '../lib/ScrollAnimations.js';
    import {
      createFloatingSphere,
      createFloatingTorus,
      createFloatingCube,
      createFloatingIcosahedron,
      createFloatingOctahedron,
      createParticleField,
      createWireframeSphere,
      createTorusKnot,
      positionRandomly
    } from '../lib/Objects3D.js';

    // Inicializar escena cuando el DOM esté listo
    let sceneManager;
    let scrollAnimations;

    function init() {
      const container = document.getElementById('three-canvas');
      if (!container) return;

      // Crear scene manager
      sceneManager = new SceneManager(container);

      // Añadir campo de partículas de fondo
      const particles = createParticleField(2000);
      sceneManager.addObject(particles);

      // Añadir esfera wireframe grande
      const wireframeSphere = createWireframeSphere(3, 0x00ffff);
      wireframeSphere.position.set(0, 0, -10);
      sceneManager.addObject(wireframeSphere);

      // Añadir objetos flotantes variados
      const colors = [0x00ffff, 0xff00ff, 0x00ff00, 0xffff00, 0xff0088];
      const objectCreators = [
        createFloatingSphere,
        createFloatingTorus,
        createFloatingCube,
        createFloatingIcosahedron,
        createFloatingOctahedron
      ];

      for (let i = 0; i < 15; i++) {
        const creator = objectCreators[Math.floor(Math.random() * objectCreators.length)];
        const color = colors[Math.floor(Math.random() * colors.length)];
        const object = creator(Math.random() * 0.5 + 0.3, color);
        positionRandomly(object, 20, 20, 10);
        sceneManager.addObject(object);
      }

      // Añadir torus knot especial
      const torusKnot = createTorusKnot(1.5, 0.4, 0xff00ff);
      torusKnot.position.set(5, 3, -5);
      sceneManager.addObject(torusKnot);

      // Inicializar sistema de scroll
      scrollAnimations = new ScrollAnimations(sceneManager);
      scrollAnimations.setupFadeIn('.fade-in');
      scrollAnimations.setupScale('.skill-card', 0.9, 1);
      scrollAnimations.setupStagger('.timeline-item', 0.2);

      // Loop de animación
      function animate() {
        requestAnimationFrame(animate);
        sceneManager.animate();
      }
      animate();

      // Manejo del formulario de contacto
      const form = document.getElementById('contact-form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          alert('¡Gracias por tu mensaje! (Esta es una demo, el formulario no envía datos reales)');
          form.reset();
        });
      }

      // Smooth scroll para enlaces internos
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = this.getAttribute('href');
          if (target && scrollAnimations) {
            scrollAnimations.scrollToSection(target);
          }
        });
      });
    }

    // Inicializar cuando el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Limpiar al salir
    window.addEventListener('beforeunload', () => {
      if (sceneManager) sceneManager.destroy();
      if (scrollAnimations) scrollAnimations.destroy();
    });
  </script>

  <style>
    /* Hero Section */
    .hero-section {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-content {
      text-align: center;
      z-index: 1;
    }

    .hero-title {
      font-size: clamp(3rem, 10vw, 8rem);
      margin-bottom: 1rem;
      font-weight: 900;
    }

    .hero-subtitle {
      font-size: clamp(1.2rem, 3vw, 2rem);
      color: var(--color-text-secondary);
      margin-bottom: 3rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
      border: none;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
    }

    /* About Section */
    .about-section {
      min-height: 100vh;
      padding: 8rem 2rem;
    }

    .about-content {
      max-width: 1200px;
      margin: 0 auto;
    }

    .about-text {
      text-align: center;
      margin-bottom: 4rem;
    }

    .section-title {
      font-size: clamp(2.5rem, 6vw, 4rem);
      margin-bottom: 1.5rem;
    }

    .about-description {
      font-size: 1.25rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .skill-card {
      padding: 2.5rem;
      transition: transform 0.3s var(--transition-smooth);
    }

    .skill-card:hover {
      transform: translateY(-10px);
    }

    .skill-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .skill-card h3 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--color-accent);
    }

    .skill-list {
      list-style: none;
      padding: 0;
    }

    .skill-list li {
      padding: 0.5rem 0;
      color: var(--color-text-secondary);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .skill-list li:last-child {
      border-bottom: none;
    }

    /* Projects Section */
    .projects-section {
      min-height: 100vh;
      padding: 8rem 2rem;
      background: rgba(255, 255, 255, 0.02);
    }

    .section-subtitle {
      color: var(--color-text-secondary);
      font-size: 1.2rem;
      margin-bottom: 4rem;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .project-card {
      padding: 0;
      overflow: hidden;
      transition: transform 0.3s var(--transition-smooth);
    }

    .project-card:hover {
      transform: translateY(-10px) scale(1.02);
    }

    .project-image {
      width: 100%;
      height: 250px;
      background: linear-gradient(135deg, rgba(0, 255, 255, 0.2), rgba(255, 0, 255, 0.2));
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .project-placeholder {
      font-size: 4rem;
      font-weight: 900;
      opacity: 0.3;
    }

    .project-number {
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .project-content {
      padding: 2rem;
    }

    .project-title {
      font-size: 1.8rem;
      margin-bottom: 1rem;
    }

    .project-description {
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
    }

    .project-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .tech-tag {
      padding: 0.3rem 0.8rem;
      background: rgba(0, 255, 255, 0.1);
      border: 1px solid rgba(0, 255, 255, 0.3);
      border-radius: 4px;
      font-size: 0.85rem;
      color: var(--color-accent);
    }

    .project-links {
      display: flex;
      gap: 1rem;
    }

    .btn-small {
      padding: 0.6rem 1.2rem;
      font-size: 0.9rem;
    }

    /* Experience Section */
    .experience-section {
      min-height: 100vh;
      padding: 8rem 2rem;
    }

    .timeline {
      max-width: 800px;
      margin: 4rem auto;
      position: relative;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 2px;
      background: linear-gradient(180deg, var(--color-accent), var(--color-accent-secondary));
    }

    .timeline-item {
      position: relative;
      padding-left: 3rem;
      margin-bottom: 3rem;
    }

    .timeline-dot {
      position: absolute;
      left: -6px;
      top: 0;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--color-accent);
      box-shadow: 0 0 20px var(--color-accent);
    }

    .timeline-content {
      padding: 2rem;
    }

    .timeline-date {
      color: var(--color-accent);
      font-weight: 600;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .timeline-content h3 {
      font-size: 1.5rem;
      margin: 0.5rem 0;
    }

    .timeline-company {
      color: var(--color-text-secondary);
      font-style: italic;
      margin-bottom: 1rem;
    }

    /* Contact Section */
    .contact-section {
      min-height: 100vh;
      padding: 8rem 2rem;
      background: rgba(255, 255, 255, 0.02);
    }

    .contact-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 4rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .contact-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .contact-description {
      font-size: 1.2rem;
      margin-bottom: 2rem;
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 1.1rem;
    }

    .contact-icon {
      font-size: 1.5rem;
    }

    .contact-item a {
      color: var(--color-text);
      text-decoration: none;
      transition: color 0.3s;
    }

    .contact-item a:hover {
      color: var(--color-accent);
    }

    .contact-form-wrapper {
      padding: 2.5rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.5rem;
      color: var(--color-text);
      font-weight: 600;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 0.8rem;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      color: var(--color-text);
      font-family: var(--font-primary);
      font-size: 1rem;
      transition: border-color 0.3s;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-accent);
    }

    .btn-full {
      width: 100%;
      margin-top: 1rem;
    }

    /* Footer */
    .footer {
      padding: 2rem;
      text-align: center;
      color: var(--color-text-secondary);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .contact-content {
        grid-template-columns: 1fr;
      }

      .projects-grid {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }

      .timeline::before {
        left: 0;
      }
    }
  </style>
</Layout>
