---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Portafolio 3D - Desarrollador Web">
  <main>
    <!-- Hero Section con Objeto Central Rotante -->
    <section id="hero" class="hero-section">
      <div class="container">
        <div class="hero-content fade-in">
          <h1 class="gradient-text hero-title text-reveal">Desarrollador Web</h1>
          <p class="hero-subtitle fade-in-delay">Creando experiencias digitales inmersivas y memorables</p>
          <div class="hero-cta fade-in-delay-2">
            <a href="#projects" class="btn btn-primary">Ver Proyectos</a>
            <a href="#contact" class="btn btn-secondary">Contacto</a>
          </div>
        </div>
        <div class="scroll-indicator">
          <div class="scroll-arrow"></div>
        </div>
      </div>
    </section>

    <!-- About/Skills Section con Partículas de Esfera -->
    <section id="about" class="about-section">
      <div class="container">
        <div class="about-content">
          <div class="about-text fade-in">
            <h2 class="section-title gradient-text">Sobre Mí</h2>
            <p class="about-description">
              Desarrollador especializado en crear experiencias web interactivas y visualmente impactantes.
              Combino diseño creativo con código limpio para construir soluciones digitales que dejan huella.
            </p>
          </div>

          <div class="skills-grid">
            <div class="skill-card glass fade-in scale-on-scroll" data-delay="0">
              <div class="skill-icon">🎨</div>
              <h3>Frontend</h3>
              <ul class="skill-list">
                <li>HTML5, CSS3, JavaScript</li>
                <li>React, Vue, Astro</li>
                <li>Three.js, GSAP, WebGL</li>
                <li>Responsive Design</li>
              </ul>
            </div>

            <div class="skill-card glass fade-in scale-on-scroll" data-delay="0.1">
              <div class="skill-icon">⚙️</div>
              <h3>Backend</h3>
              <ul class="skill-list">
                <li>Node.js, Express</li>
                <li>Python, Django</li>
                <li>RESTful APIs</li>
                <li>Databases (SQL, NoSQL)</li>
              </ul>
            </div>

            <div class="skill-card glass fade-in scale-on-scroll" data-delay="0.2">
              <div class="skill-icon">🚀</div>
              <h3>DevOps & Tools</h3>
              <ul class="skill-list">
                <li>Git, GitHub Actions</li>
                <li>Docker, CI/CD</li>
                <li>Webpack, Vite</li>
                <li>Testing (Jest, Vitest)</li>
              </ul>
            </div>

            <div class="skill-card glass fade-in scale-on-scroll" data-delay="0.3">
              <div class="skill-icon">💡</div>
              <h3>3D & Animation</h3>
              <ul class="skill-list">
                <li>Three.js, WebGL</li>
                <li>GSAP Animations</li>
                <li>Scroll Animations</li>
                <li>Interactive Experiences</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section con Scroll Horizontal -->
    <section id="projects" class="projects-section-horizontal">
      <div class="container-full">
        <div class="projects-header fade-in">
          <h2 class="section-title text-center gradient-text">Proyectos Destacados</h2>
          <p class="section-subtitle text-center">
            Desliza horizontalmente para explorar
          </p>
        </div>

        <div class="horizontal-scroll-wrapper">
          <div class="projects-track">
            <article class="project-card-large glass">
              <div class="project-number">01</div>
              <div class="project-visual">
                <div class="project-placeholder"></div>
              </div>
              <div class="project-content">
                <h3 class="project-title">E-Commerce 3D</h3>
                <p class="project-description">
                  Plataforma de comercio electrónico con visualización 3D de productos en tiempo real.
                  Incluye carrito interactivo, pasarela de pagos y sistema de recomendaciones.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">React</span>
                  <span class="tech-tag">Three.js</span>
                  <span class="tech-tag">Node.js</span>
                  <span class="tech-tag">MongoDB</span>
                </div>
                <div class="project-links">
                  <a href="#" class="btn btn-small">Ver Demo</a>
                  <a href="#" class="btn btn-small">GitHub</a>
                </div>
              </div>
            </article>

            <article class="project-card-large glass">
              <div class="project-number">02</div>
              <div class="project-visual">
                <div class="project-placeholder"></div>
              </div>
              <div class="project-content">
                <h3 class="project-title">Portfolio Interactivo</h3>
                <p class="project-description">
                  Portafolio personal con animaciones avanzadas de scroll y efectos 3D inmersivos.
                  Diseño responsive y optimizado para rendimiento en todos los dispositivos.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Astro</span>
                  <span class="tech-tag">GSAP</span>
                  <span class="tech-tag">WebGL</span>
                  <span class="tech-tag">Lenis</span>
                </div>
                <div class="project-links">
                  <a href="#" class="btn btn-small">Ver Demo</a>
                  <a href="#" class="btn btn-small">GitHub</a>
                </div>
              </div>
            </article>

            <article class="project-card-large glass">
              <div class="project-number">03</div>
              <div class="project-visual">
                <div class="project-placeholder"></div>
              </div>
              <div class="project-content">
                <h3 class="project-title">Dashboard Analítico</h3>
                <p class="project-description">
                  Dashboard en tiempo real con visualizaciones de datos interactivas y animadas.
                  Sistema completo de métricas, reportes y exportación de datos.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Vue</span>
                  <span class="tech-tag">D3.js</span>
                  <span class="tech-tag">Python</span>
                  <span class="tech-tag">PostgreSQL</span>
                </div>
                <div class="project-links">
                  <a href="#" class="btn btn-small">Ver Demo</a>
                  <a href="#" class="btn btn-small">GitHub</a>
                </div>
              </div>
            </article>

            <article class="project-card-large glass">
              <div class="project-number">04</div>
              <div class="project-visual">
                <div class="project-placeholder"></div>
              </div>
              <div class="project-content">
                <h3 class="project-title">App de Streaming</h3>
                <p class="project-description">
                  Plataforma de streaming de video con recomendaciones personalizadas.
                  Interfaz moderna con reproductor customizado y lista de reproducción.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Next.js</span>
                  <span class="tech-tag">TypeScript</span>
                  <span class="tech-tag">AWS</span>
                  <span class="tech-tag">Redis</span>
                </div>
                <div class="project-links">
                  <a href="#" class="btn btn-small">Ver Demo</a>
                  <a href="#" class="btn btn-small">GitHub</a>
                </div>
              </div>
            </article>

            <article class="project-card-large glass">
              <div class="project-number">05</div>
              <div class="project-visual">
                <div class="project-placeholder"></div>
              </div>
              <div class="project-content">
                <h3 class="project-title">API Gateway</h3>
                <p class="project-description">
                  Sistema de API Gateway con autenticación, rate limiting y balanceo de carga.
                  Documentación automática con Swagger y monitoreo en tiempo real.
                </p>
                <div class="project-tech">
                  <span class="tech-tag">Go</span>
                  <span class="tech-tag">gRPC</span>
                  <span class="tech-tag">Docker</span>
                  <span class="tech-tag">Kubernetes</span>
                </div>
                <div class="project-links">
                  <a href="#" class="btn btn-small">Ver Demo</a>
                  <a href="#" class="btn btn-small">GitHub</a>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Experience Section con DNA Helix -->
    <section id="experience" class="experience-section">
      <div class="container">
        <h2 class="section-title text-center fade-in gradient-text">Experiencia</h2>

        <div class="timeline">
          <div class="timeline-item fade-in" data-delay="0">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass">
              <span class="timeline-date">2023 - Presente</span>
              <h3>Senior Frontend Developer</h3>
              <p class="timeline-company">Tech Company Inc.</p>
              <p>
                Liderando el desarrollo de interfaces 3D interactivas y experiencias web inmersivas
                utilizando las últimas tecnologías. Implementación de arquitecturas escalables y
                mentoring de desarrolladores junior.
              </p>
            </div>
          </div>

          <div class="timeline-item fade-in" data-delay="0.2">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass">
              <span class="timeline-date">2021 - 2023</span>
              <h3>Full Stack Developer</h3>
              <p class="timeline-company">Digital Agency Co.</p>
              <p>
                Desarrollo de aplicaciones web completas, desde el diseño hasta la implementación,
                con enfoque en rendimiento y experiencia de usuario. Gestión de proyectos y cliente.
              </p>
            </div>
          </div>

          <div class="timeline-item fade-in" data-delay="0.4">
            <div class="timeline-dot"></div>
            <div class="timeline-content glass">
              <span class="timeline-date">2019 - 2021</span>
              <h3>Frontend Developer</h3>
              <p class="timeline-company">Startup Studio</p>
              <p>
                Creación de interfaces de usuario modernas y responsivas para diversos proyectos
                de startups en crecimiento. Colaboración en equipos ágiles multidisciplinarios.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact-section">
      <div class="container">
        <div class="contact-content">
          <div class="contact-text fade-in">
            <h2 class="section-title gradient-text">¿Trabajamos Juntos?</h2>
            <p class="contact-description">
              Estoy disponible para proyectos freelance y colaboraciones.
              Si tienes una idea o necesitas ayuda con tu proyecto, ¡hablemos!
            </p>

            <div class="contact-info">
              <div class="contact-item">
                <span class="contact-icon">📧</span>
                <a href="mailto:tu@email.com">tu@email.com</a>
              </div>
              <div class="contact-item">
                <span class="contact-icon">💼</span>
                <a href="https://linkedin.com" target="_blank">LinkedIn</a>
              </div>
              <div class="contact-item">
                <span class="contact-icon">🐙</span>
                <a href="https://github.com" target="_blank">GitHub</a>
              </div>
              <div class="contact-item">
                <span class="contact-icon">🐦</span>
                <a href="https://twitter.com" target="_blank">Twitter</a>
              </div>
            </div>
          </div>

          <div class="contact-form-wrapper glass fade-in">
            <form class="contact-form" id="contact-form">
              <div class="form-group">
                <label for="name">Nombre</label>
                <input type="text" id="name" name="name" required />
              </div>

              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required />
              </div>

              <div class="form-group">
                <label for="message">Mensaje</label>
                <textarea id="message" name="message" rows="5" required></textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-full">Enviar Mensaje</button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <p>&copy; 2024 Portafolio 3D. Creado con Astro y Three.js</p>
      </div>
    </footer>
  </main>

  <script>
    import { SceneManager } from '../lib/SceneManager.js';
    import { ScrollAnimations } from '../lib/ScrollAnimations.js';
    import {
      createHeroCentralObject,
      createOrbitalSphere,
      createMorphingShape,
      createParticleSphere,
      createGeometricTunnel,
      createHelix,
      createInteractiveParticles,
      createDNAHelix
    } from '../lib/Objects3D.js';

    let sceneManager;
    let scrollAnimations;
    let heroCentralObject;

    function init() {
      const container = document.getElementById('three-canvas');
      if (!container) return;

      sceneManager = new SceneManager(container);

      // ===== HERO SECTION =====
      // Objeto central que rota con el scroll (como lata de Brew District)
      heroCentralObject = createHeroCentralObject();
      heroCentralObject.position.set(0, 0, 0);
      sceneManager.addObject(heroCentralObject);

      // Esferas orbitales alrededor del objeto central
      const orbitalColors = [0x00ffff, 0xff00ff, 0x00ff00, 0xffff00, 0xff0088];
      for (let i = 0; i < 5; i++) {
        const orbital = createOrbitalSphere(
          0.2,
          4,
          orbitalColors[i],
          (i / 5) * Math.PI * 2
        );
        sceneManager.addObject(orbital);
      }

      // ===== ABOUT SECTION =====
      // Esfera de partículas que se expande/contrae
      const particleSphere = createParticleSphere(3000, 4);
      particleSphere.position.set(0, 0, -15);
      sceneManager.addObject(particleSphere);

      // Morphing shape
      const morphingShape = createMorphingShape();
      morphingShape.position.set(6, 2, -8);
      sceneManager.addObject(morphingShape);

      // ===== PROJECTS SECTION =====
      // Túnel geométrico
      const tunnel = createGeometricTunnel(30);
      tunnel.position.set(0, 0, -40);
      sceneManager.addObject(tunnel);

      // ===== EXPERIENCE SECTION =====
      // DNA Helix
      const dnaHelix = createDNAHelix(80, 18);
      dnaHelix.position.set(-5, 0, -60);
      sceneManager.addObject(dnaHelix);

      // Helix simple
      const helix = createHelix(60, 25, 2.5);
      helix.position.set(5, 0, -60);
      sceneManager.addObject(helix);

      // ===== PARTÍCULAS DE FONDO =====
      // Partículas interactivas que responden al mouse
      const interactiveParticles = createInteractiveParticles(4000);
      sceneManager.addObject(interactiveParticles);

      // ===== SCROLL ANIMATIONS =====
      scrollAnimations = new ScrollAnimations(sceneManager);
      scrollAnimations.setupFadeIn('.fade-in');

      // Setup stagger con delays personalizados
      document.querySelectorAll('[data-delay]').forEach((el) => {
        const delay = parseFloat(el.dataset.delay || 0);
        setTimeout(() => {
          el.classList.add('active');
        }, delay * 1000);
      });

      // Scale animation para skill cards
      scrollAnimations.setupScale('.scale-on-scroll', 0.85, 1);

      // Stagger para timeline
      scrollAnimations.setupStagger('.timeline-item', 0.2);

      // Horizontal scroll para proyectos
      scrollAnimations.setupHorizontalScroll('.horizontal-scroll-wrapper', '.projects-track');

      // ===== ANIMATION LOOP =====
      function animate() {
        requestAnimationFrame(animate);
        sceneManager.animate();
      }
      animate();

      // ===== EVENT LISTENERS =====
      // Formulario de contacto
      const form = document.getElementById('contact-form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          alert('¡Gracias por tu mensaje! (Esta es una demo, el formulario no envía datos reales)');
          form.reset();
        });
      }

      // Smooth scroll para enlaces internos
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = this.getAttribute('href');
          if (target && scrollAnimations) {
            scrollAnimations.scrollToSection(target);
          }
        });
      });

      // Scroll indicator
      const scrollIndicator = document.querySelector('.scroll-indicator');
      if (scrollIndicator) {
        scrollIndicator.addEventListener('click', () => {
          scrollAnimations.scrollToSection('#about');
        });
      }
    }

    // Inicializar
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Cleanup
    window.addEventListener('beforeunload', () => {
      if (sceneManager) sceneManager.destroy();
      if (scrollAnimations) scrollAnimations.destroy();
    });
  </script>

  <style>
    /* ========== HERO SECTION ========== */
    .hero-section {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .hero-content {
      text-align: center;
      z-index: 1;
      position: relative;
    }

    .hero-title {
      font-size: clamp(3rem, 12vw, 10rem);
      margin-bottom: 1rem;
      font-weight: 900;
      letter-spacing: -0.03em;
    }

    .text-reveal {
      animation: textReveal 1.5s cubic-bezier(0.77, 0, 0.175, 1);
    }

    @keyframes textReveal {
      0% {
        opacity: 0;
        transform: translateY(100px) scale(0.8);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .hero-subtitle {
      font-size: clamp(1.2rem, 3vw, 2.5rem);
      color: var(--color-text-secondary);
      margin-bottom: 3rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
    }

    .fade-in-delay {
      animation: fadeInUp 1s cubic-bezier(0.77, 0, 0.175, 1) 0.3s backwards;
    }

    .fade-in-delay-2 {
      animation: fadeInUp 1s cubic-bezier(0.77, 0, 0.175, 1) 0.6s backwards;
    }

    @keyframes fadeInUp {
      0% {
        opacity: 0;
        transform: translateY(30px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hero-cta {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
      border: none;
      box-shadow: 0 10px 40px rgba(0, 255, 255, 0.4);
    }

    .btn-primary:hover {
      box-shadow: 0 15px 50px rgba(0, 255, 255, 0.6);
      transform: translateY(-3px);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.05);
      border: 2px solid rgba(255, 255, 255, 0.2);
    }

    .scroll-indicator {
      position: absolute;
      bottom: 3rem;
      left: 50%;
      transform: translateX(-50%);
      cursor: pointer;
      z-index: 10;
    }

    .scroll-arrow {
      width: 30px;
      height: 50px;
      border: 2px solid var(--color-accent);
      border-radius: 25px;
      position: relative;
    }

    .scroll-arrow::before {
      content: '';
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      width: 6px;
      height: 6px;
      background: var(--color-accent);
      border-radius: 50%;
      animation: scrollDown 2s infinite;
    }

    @keyframes scrollDown {
      0%, 100% {
        top: 10px;
        opacity: 1;
      }
      50% {
        top: 30px;
        opacity: 0.5;
      }
    }

    /* ========== ABOUT SECTION ========== */
    .about-section {
      min-height: 100vh;
      padding: 8rem 2rem;
      position: relative;
    }

    .about-content {
      max-width: 1200px;
      margin: 0 auto;
    }

    .about-text {
      text-align: center;
      margin-bottom: 4rem;
    }

    .section-title {
      font-size: clamp(2.5rem, 7vw, 5rem);
      margin-bottom: 1.5rem;
      font-weight: 900;
    }

    .about-description {
      font-size: 1.3rem;
      max-width: 800px;
      margin: 0 auto;
      line-height: 1.8;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2.5rem;
      margin-top: 3rem;
    }

    .skill-card {
      padding: 2.5rem;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .skill-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.1), transparent);
      transition: left 0.5s;
    }

    .skill-card:hover::before {
      left: 100%;
    }

    .skill-card:hover {
      transform: translateY(-15px) scale(1.02);
      box-shadow: 0 20px 60px rgba(0, 255, 255, 0.3);
    }

    .skill-icon {
      font-size: 3.5rem;
      margin-bottom: 1rem;
      filter: drop-shadow(0 0 20px currentColor);
    }

    .skill-card h3 {
      font-size: 1.8rem;
      margin-bottom: 1.5rem;
      color: var(--color-accent);
      font-weight: 700;
    }

    .skill-list {
      list-style: none;
      padding: 0;
    }

    .skill-list li {
      padding: 0.75rem 0;
      color: var(--color-text-secondary);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.3s;
    }

    .skill-list li:hover {
      color: var(--color-text);
      padding-left: 10px;
    }

    .skill-list li:last-child {
      border-bottom: none;
    }

    /* ========== PROJECTS HORIZONTAL SCROLL ========== */
    .projects-section-horizontal {
      min-height: 100vh;
      padding: 8rem 0;
      background: rgba(255, 255, 255, 0.02);
      position: relative;
      overflow: hidden;
    }

    .container-full {
      width: 100%;
    }

    .projects-header {
      padding: 0 2rem;
      margin-bottom: 4rem;
    }

    .section-subtitle {
      color: var(--color-text-secondary);
      font-size: 1.3rem;
      margin-top: 1rem;
    }

    .horizontal-scroll-wrapper {
      overflow: hidden;
      position: relative;
    }

    .projects-track {
      display: flex;
      gap: 3rem;
      padding: 2rem;
      will-change: transform;
    }

    .project-card-large {
      min-width: 500px;
      max-width: 500px;
      padding: 0;
      overflow: hidden;
      position: relative;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      flex-shrink: 0;
    }

    .project-card-large:hover {
      transform: translateY(-10px) scale(1.02);
      box-shadow: 0 30px 80px rgba(0, 255, 255, 0.4);
    }

    .project-number {
      position: absolute;
      top: 2rem;
      right: 2rem;
      font-size: 4rem;
      font-weight: 900;
      background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      z-index: 2;
      opacity: 0.3;
    }

    .project-visual {
      width: 100%;
      height: 300px;
      position: relative;
      overflow: hidden;
    }

    .project-placeholder {
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(0, 255, 255, 0.2), rgba(255, 0, 255, 0.2));
      transition: all 0.4s;
    }

    .project-card-large:hover .project-placeholder {
      transform: scale(1.1);
    }

    .project-content {
      padding: 2.5rem;
    }

    .project-title {
      font-size: 2rem;
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .project-description {
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      line-height: 1.7;
      font-size: 1.05rem;
    }

    .project-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 2rem;
    }

    .tech-tag {
      padding: 0.4rem 1rem;
      background: rgba(0, 255, 255, 0.1);
      border: 1px solid rgba(0, 255, 255, 0.3);
      border-radius: 6px;
      font-size: 0.9rem;
      color: var(--color-accent);
      font-weight: 600;
      transition: all 0.3s;
    }

    .tech-tag:hover {
      background: rgba(0, 255, 255, 0.2);
      transform: translateY(-2px);
    }

    .project-links {
      display: flex;
      gap: 1rem;
    }

    .btn-small {
      padding: 0.7rem 1.5rem;
      font-size: 0.95rem;
    }

    /* ========== EXPERIENCE SECTION ========== */
    .experience-section {
      min-height: 100vh;
      padding: 8rem 2rem;
    }

    .timeline {
      max-width: 900px;
      margin: 4rem auto;
      position: relative;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 3px;
      background: linear-gradient(180deg, var(--color-accent), var(--color-accent-secondary));
      box-shadow: 0 0 20px var(--color-accent);
    }

    .timeline-item {
      position: relative;
      padding-left: 4rem;
      margin-bottom: 4rem;
    }

    .timeline-dot {
      position: absolute;
      left: -7px;
      top: 0;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--color-accent);
      box-shadow: 0 0 30px var(--color-accent);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% {
        box-shadow: 0 0 30px var(--color-accent);
        transform: scale(1);
      }
      50% {
        box-shadow: 0 0 50px var(--color-accent);
        transform: scale(1.2);
      }
    }

    .timeline-content {
      padding: 2.5rem;
      transition: all 0.3s;
    }

    .timeline-content:hover {
      transform: translateX(10px);
      box-shadow: 0 20px 60px rgba(0, 255, 255, 0.2);
    }

    .timeline-date {
      color: var(--color-accent);
      font-weight: 700;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 2px;
    }

    .timeline-content h3 {
      font-size: 1.8rem;
      margin: 0.7rem 0;
    }

    .timeline-company {
      color: var(--color-text-secondary);
      font-style: italic;
      margin-bottom: 1rem;
      font-size: 1.1rem;
    }

    /* ========== CONTACT SECTION ========== */
    .contact-section {
      min-height: 100vh;
      padding: 8rem 2rem;
      background: rgba(255, 255, 255, 0.02);
    }

    .contact-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: 4rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .contact-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .contact-description {
      font-size: 1.25rem;
      margin-bottom: 2.5rem;
      line-height: 1.8;
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      font-size: 1.15rem;
      transition: all 0.3s;
      padding: 0.5rem;
      border-radius: 8px;
    }

    .contact-item:hover {
      background: rgba(255, 255, 255, 0.05);
      transform: translateX(10px);
    }

    .contact-icon {
      font-size: 1.8rem;
    }

    .contact-item a {
      color: var(--color-text);
      text-decoration: none;
      transition: color 0.3s;
    }

    .contact-item a:hover {
      color: var(--color-accent);
    }

    .contact-form-wrapper {
      padding: 3rem;
    }

    .form-group {
      margin-bottom: 2rem;
    }

    .form-group label {
      display: block;
      margin-bottom: 0.7rem;
      color: var(--color-text);
      font-weight: 700;
      font-size: 1.05rem;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 1rem;
      background: rgba(255, 255, 255, 0.05);
      border: 2px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      color: var(--color-text);
      font-family: var(--font-primary);
      font-size: 1.05rem;
      transition: all 0.3s;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--color-accent);
      box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
      background: rgba(255, 255, 255, 0.08);
    }

    .btn-full {
      width: 100%;
      margin-top: 1.5rem;
      padding: 1.2rem;
      font-size: 1.1rem;
      font-weight: 700;
    }

    /* ========== FOOTER ========== */
    .footer {
      padding: 3rem 2rem;
      text-align: center;
      color: var(--color-text-secondary);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 1.05rem;
    }

    /* ========== RESPONSIVE ========== */
    @media (max-width: 1024px) {
      .project-card-large {
        min-width: 400px;
        max-width: 400px;
      }
    }

    @media (max-width: 768px) {
      .contact-content {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }

      .timeline::before {
        left: 0;
      }

      .project-card-large {
        min-width: 320px;
        max-width: 320px;
      }

      .projects-track {
        padding: 2rem 1rem;
      }
    }

    @media (max-width: 480px) {
      .hero-title {
        font-size: 2.5rem;
      }

      .section-title {
        font-size: 2rem;
      }
    }
  </style>
</Layout>
